{
    "manifest_version": 3,
    "name": "MeetMind Live Assistant",
    "version": "1.0.0",
    "description": "Live AI transcription, OCR, and Q&A for Google Meet.",
    "permissions": [
        "activeTab",
        "tabCapture",
        "offscreen"
    ],
    "host_permissions": [
        "https://meet.google.com/*",
        "http://localhost:8000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Start Live Assistant"
    },
    "background": {
        "service_worker": "background.js"
    }
}